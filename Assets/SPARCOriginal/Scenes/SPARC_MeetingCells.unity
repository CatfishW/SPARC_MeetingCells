--- !u!114 &1992250865
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1992250863}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f20507b741684cb7802c656cb4b1b101, type: 3}
  m_Name: null
  m_EditorClassIdentifier: 
  sourceType: Text2Speech
  sourceId: 1992250865
  sourceScope: scene
  configJson: "{\"NameText\":{\"fileID\":0},\"CurrentDialog\":null,\"DialogList\":[\"Watch
    out, pal, you almost get hit by that RBC.\",\"I am CAP. I\u2019ve been here a
    little while.\",\"Look ahead, that is my friend, RED\",\"Be careful!\",\"Wait
    a second, Red, don\u2019t all cells have nuclei?\",\"What happened to yours?\",\"Wow!
    I didn\u2019t know you were such a high-tech delivery expert, Red.\",\"That\u2019s
    incredible!\",\"I think Red blood cells have a nucleus. So I choose A.\",\"Infection?\",\"Oh
    no...\",\"Explorer, you take the lead.\",\"Good call, Red. Phew! Let\u2019s keep
    going, Explorer!\",\"Wow! White\u2019s like a real-life superhero!\",\"Wait,
    you have types?\",\"Like\u2026 superhero squads?\",\"That\u2019s amazing!\",\"The
    heart? Oh man, I can\u2019t wait! Lead the way, team!\"],\"Pause\":0,\"Gender\":1,\"Culture\":\"en\",\"Pitch\":1,\"Rate\":1.5,\"Volume\":0.728}"
  sourceReferences: []
